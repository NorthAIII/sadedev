#!/bin/bash
# Commit'e sir sizmasini engelleyen son savunma hatti.
# Devre disi birakmak icin: git commit --no-verify
KALIP='(BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{30,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,}|(password|passwd|sifre|parola|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9!@#$%^&*_+=/-]{12,})'
BULUNAN=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
  [ -f "$f" ] || continue
  git show ":$f" 2>/dev/null | grep -nIiE "$KALIP" 2>/dev/null \
    | grep -viE 'example|placeholder|<[a-z_]+>|xxx|your[_-]|BURAYA|\$\{|\$[A-Z_]+' \
    | sed "s|^|  $f:|"
done)
if [ -n "$BULUNAN" ]; then
  echo "COMMIT DURDURULDU - sir benzeri icerik bulundu:"
  echo "$BULUNAN"
  echo
  echo "Gercekten sir degilse: git commit --no-verify"
  exit 1
fi
exit 0
